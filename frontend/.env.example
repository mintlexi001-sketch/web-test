# ─────────────────────────────────────────────────────────────────────
# Frontend Environment Variables
# ─────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# NEVER commit the actual .env file (it is in .gitignore).

# Your Supabase project URL (found in Project Settings → API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anonymous/public API key (safe to expose in the browser)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# The deployed URL of your backend API (no trailing slash)
# In development, leave blank or set to http://localhost:3001
# In production, must be an https:// URL — the build will fail without it
VITE_API_URL=https://your-backend.vercel.app

# Cloudflare Turnstile site key (browser-side, public)
# Get from: https://dash.cloudflare.com → Turnstile → your widget
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key_here

# Permanent admin account that cannot be banned or deleted (must match DB exactly)
VITE_PERMANENT_ADMIN_EMAIL=admin@example.com
