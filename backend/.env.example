# ============================================================
# .env.example — Required environment variables
# Copy this file to .env for local development and fill in real values.
# For production (Render), set these in the Render environment variables dashboard.
# NEVER commit your actual .env file with real secrets.
# ============================================================

PORT=3001

# Gmail SMTP — use an App Password (not your account password)
# Generate at: https://myaccount.google.com/apppasswords
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password


# Supabase project URL — found in Dashboard > Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service role key — found in Dashboard > Project Settings > API
# WARNING: This key bypasses ALL Row Level Security policies.
# Never expose it in client-side code or commit it to git.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...your-service-role-key

# Your deployed frontend URL — used in email templates for action button links
# In development: http://localhost:5173
# In production: https://your-app.vercel.app  (or your custom domain)
APP_URL=http://localhost:5173

# The URL of your deployed frontend — used for CORS origin whitelisting
# In production, set this to your live Vercel frontend domain (e.g. https://your-app.vercel.app)
FRONTEND_URL=http://localhost:5173

# Set to 'production' when deploying
NODE_ENV=development


# Sentry DSN — optional, for error monitoring in production
# Get from: https://sentry.io → Project Settings → Client Keys (DSN)
SENTRY_DSN=
